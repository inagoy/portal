---
import { getNavBarLinks, identity } from "../config";
import { normalizeLang, type Lang } from "../i18n";
import LanguageSelector from "../components/LanguageSelector.astro";
import type { SEOInfo } from "../types/config";

interface Props {
  seo: SEOInfo;
  lang?: Lang;
}

const { seo } = Astro.props;
const pageTitle = seo.title.replace("iñaki goyeneche", "inagoi");
const url = Astro.url;
const currentUrl = url.pathname.endsWith('/') ? url.pathname.slice(0, -1) : url.pathname;
const pageLang: Lang = normalizeLang(Astro.props.lang as string | undefined);
const navBarLinks = getNavBarLinks(pageLang);
function withLangPath(u: URL, lang: string): string {
  const rest = u.pathname.replace(/^\/(en|es)/, '');
  const path = `/${lang}${rest}`;
  return path;
}
const esHref = withLangPath(url, 'es');
const enHref = withLangPath(url, 'en');

---

<style is:global>
  @font-face {
    font-family: "Inter";
    src: url("/fonts/InterVariable.woff2") format("woff2");
    font-weight: 100 900;
    font-display: swap;
  }

  :root {
    --bg: #d87595;
    --paper: #f3efdc;
    --text: #171711;
    --text-strong: #050505;
    --muted: #655f4f;
    --line: #171711;
    --soft: #d8d3b5;
    --accent: #ef3340;
    --cyan: #1ebbb5;
    --yellow: #f0cf3f;
    --media-opacity: 0.9;
    --media-hover-opacity: 1;
  }

  html {
    background-color: var(--bg);
    color: var(--text);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 15px;
    overflow-y: scroll;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  * {
    box-sizing: border-box;
    color: inherit;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  body {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    padding-right: calc(100vw - 100%);
    text-transform: lowercase;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background: url("/textures/velvet.jpg") center / cover;
    mix-blend-mode: multiply;
    opacity: 0.1;
    pointer-events: none;
  }

  body::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    background-image: radial-gradient(rgba(23, 23, 17, 0.28) 0.6px, transparent 0.7px);
    background-size: 5px 5px;
    opacity: 0.28;
    pointer-events: none;
  }

  a {
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--text-strong);
    outline-offset: 3px;
  }

  .site-shell {
    position: relative;
    isolation: isolate;
    width: min(calc(100% - 1rem), 48rem);
    margin: 0.5rem auto 1rem;
    border: 2px solid var(--line);
    background: var(--paper);
  }

  .site-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(rgba(23, 23, 17, 0.22) 0.5px, transparent 0.7px);
    background-size: 4px 4px;
    opacity: 0.26;
    pointer-events: none;
  }

  .site-shell > * {
    position: relative;
    z-index: 1;
  }

  .site-shell > header {
    z-index: auto;
    border-bottom: 2px solid var(--line);
  }

  .mobile-menu-toggle {
    display: flex;
    min-height: 3rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    gap: 0.55rem;
    border: 2px solid var(--line);
    background: rgb(78 143 82 / 0.82);
    padding: 0.55rem 0.7rem;
    font-weight: 750;
  }

  .mobile-menu-toggle::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-toggle::after {
    content: "+";
    font-size: 1.1rem;
    line-height: 0;
  }

  .mobile-menu[open] .mobile-menu-toggle::after {
    content: "−";
  }

  .mobile-menu-panel {
    position: absolute;
    z-index: 40;
    top: calc(100% + 0.9rem);
    right: 0;
    width: min(21rem, calc(100vw - 2rem));
    border: 2px solid var(--line);
    background: var(--paper);
    counter-reset: mobile-link;
    animation: mobile-menu-reveal 140ms ease both;
  }

  .mobile-menu-panel li {
    counter-increment: mobile-link;
  }

  .mobile-menu-panel li:nth-child(odd) {
    background: rgb(78 143 82 / 0.82);
  }

  .mobile-menu-panel li + li {
    border-top: 1.5px solid var(--line);
  }

  .mobile-menu-panel a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    min-height: 3.25rem;
    align-items: center;
    padding: 0.6rem 0.75rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .mobile-menu-panel a::before {
    content: "A" counter(mobile-link);
    text-transform: uppercase;
  }

  .mobile-menu-panel a:hover,
  .mobile-menu-panel a:focus-visible,
  .mobile-menu-panel a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  @keyframes mobile-menu-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
  }

  .page {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .page-header {
    margin-bottom: 2.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--line);
  }

  .page-title {
    display: inline;
    padding: 0.03em 0.14em 0.08em;
    background: var(--accent);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 1.15;
    text-transform: uppercase;
    box-shadow: inset 0 0 0 2px var(--line);
  }

  .page-title.home-title {
    font-size: clamp(2.35rem, 11.5vw, 3.7rem);
  }

  .muted {
    color: var(--muted);
  }

  .text-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: background-color 140ms ease, color 140ms ease;
  }

  .text-link:hover,
  .text-link:focus-visible,
  .text-link[aria-current] {
    background: var(--accent);
    color: var(--text-strong);
    text-decoration: none;
  }

  .social-link {
    display: inline-block;
    border: 1.5px solid var(--line);
    background: var(--paper);
    padding: 0.32rem 0.52rem 0.38rem;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .social-link:hover,
  .social-link:focus-visible {
    background: var(--yellow);
  }

  .home-links {
    display: grid;
    gap: 0;
    border: 2px solid var(--line);
    counter-reset: home-link;
  }

  .primary-link {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    min-height: 2.75rem;
    align-items: center;
    border: 0;
    border-bottom: 1.5px solid var(--line);
    background: rgb(243 239 220 / 0.75);
    padding: 0.35rem 0.55rem;
    color: var(--text-strong);
    font-weight: 700;
    text-decoration: none;
    counter-increment: home-link;
  }

  .primary-link::before {
    content: "A" counter(home-link);
    text-transform: uppercase;
  }

  .primary-link:nth-child(odd) {
    background: rgb(78 143 82 / 0.82);
  }

  .primary-link:last-child {
    border-bottom: 0;
  }

  .primary-link > div {
    display: none;
  }

  .primary-link span {
    width: fit-content;
    transition: background-color 140ms ease;
  }

  .primary-link:hover span,
  .primary-link:focus-visible span {
    background: var(--accent);
  }

  .project-row img,
  .music-card-cover img {
    filter: saturate(0.78) contrast(1.06);
    opacity: var(--media-opacity);
    transition: filter 180ms ease, opacity 180ms ease, transform 180ms ease;
  }

  .project-row:hover img,
  .project-row:focus-visible img,
  .music-card:hover .music-card-cover img,
  .music-card:focus-within .music-card-cover img {
    filter: saturate(1) contrast(1.03);
    opacity: var(--media-hover-opacity);
  }

  .project-row {
    display: grid;
    gap: 0.85rem;
    border-top: 2px solid var(--line);
    padding: 1.1rem 0;
  }

  .project-row > :first-child,
  .music-card-cover {
    border: 1.5px solid var(--line);
    border-radius: 0 !important;
  }

  .kamehouse-list > .music-card-compact::before {
    background: var(--accent) !important;
  }

  .kamehouse-label {
    color: var(--text) !important;
  }

  .invalid-feedback,
  .empty-feedback {
    color: #97152e !important;
  }

  .media-project-row {
    grid-template-columns: clamp(4.5rem, 22vw, 5.5rem) minmax(0, 1fr);
    align-items: start;
    padding: 0.95rem 0;
  }

  @media (min-width: 640px) {
    html {
      font-size: 16px;
    }

    .page {
      padding: 0 1.5rem;
    }

    .page-header {
      margin-bottom: 3.5rem;
    }

    .page-title {
      font-size: clamp(2.5rem, 7vw, 4rem);
    }

    .page-title.home-title {
      font-size: clamp(3.25rem, 8vw, 4.75rem);
    }

    .project-row {
      grid-template-columns: 8rem 1fr;
      gap: 1rem;
      padding: 1.5rem 0;
    }
  }

  .field {
    width: 100%;
    border: 2px solid var(--line);
    border-radius: 0;
    background: rgba(255, 255, 255, 0.24);
    padding: 0.75rem 0.9rem;
    color: var(--text);
    outline: none;
  }

  .field::placeholder {
    color: var(--muted);
  }

  .field:focus {
    background: rgba(255, 255, 255, 0.48);
  }

  .button {
    border: 2px solid var(--line);
    background: var(--yellow);
    padding: 0.75rem 1rem;
    color: var(--text-strong);
    font-weight: 700;
    box-shadow: 3px 3px 0 var(--line);
    transition: background-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
  }

  .button:hover,
  .button:focus-visible {
    background: var(--accent);
    box-shadow: none;
    color: var(--text-strong);
    transform: translate(3px, 3px);
  }

  @media (min-width: 640px) {
    .field {
      padding: 0.85rem 1rem;
    }

    .button {
      padding: 0.85rem 1.1rem;
    }
  }

  @media (min-width: 640px) {
    .site-shell {
      width: min(calc(100% - 3rem), 48rem);
      margin-top: 1.5rem;
    }
  }

  @media (max-width: 639px) {
    body::after {
      background-image: none;
    }

    .site-shell::before {
      background-image: radial-gradient(rgba(23, 23, 17, 0.14) 0.35px, transparent 0.55px);
      background-size: 6px 6px;
      opacity: 0.14;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-link,
    .social-link,
    .primary-link,
    .project-row img,
    .music-card-cover img,
    .button,
    .mobile-menu-toggle,
    .mobile-menu-panel,
    .mobile-menu-panel a {
      transition: none;
      animation: none;
    }
  }
</style>

<html lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={seo.description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
    
  </head>
  <body>
    <div class="site-shell">
      <header>
        <div
          class="page flex items-center justify-between py-7 sm:py-9"
        >
          <a href={`/${pageLang}/`} class="text-link text-sm">
            <img
              src={identity.logo}
              alt={"Logo"}
              width="46"
              height="46"
              class="block h-12 w-auto brightness-0 sm:h-14"
            />
          </a>
          <nav class="relative ml-auto flex items-center gap-3 text-[0.8125rem] sm:gap-5 sm:text-sm">
            <ul class="hidden sm:flex sm:items-center sm:gap-5">
              {
                navBarLinks.map((link) => (
                  <li>
                    <a
                      class="text-link whitespace-nowrap"
                      href={link.url}
                      target={link.external ? "_blank" : "_self"}
                      aria-current={currentUrl === link.url ? "page" : undefined}
                    >
                      {link.title}
                    </a>
                  </li>
                ))
              }
            </ul>
            <details id="mobile-menu" class="mobile-menu static sm:hidden">
              <summary class="mobile-menu-toggle">menu</summary>
              <div class="mobile-menu-panel">
                <ul>
                  {
                    navBarLinks.map((link) => (
                      <li>
                        <a
                          class="block whitespace-nowrap"
                          href={link.url}
                          target={link.external ? "_blank" : "_self"}
                          aria-current={currentUrl === link.url ? "page" : undefined}
                        >
                          {link.title}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </details>
            <LanguageSelector lang={pageLang} esHref={esHref} enHref={enHref} />
          </nav>
        </div>
      </header>
      <main class="pb-8 sm:pb-14">
        <slot />
      </main>
      <footer></footer>
    </div>
  </body>
</html>

<script>
  const mobileMenu = document.getElementById("mobile-menu") as HTMLDetailsElement | null;

  document.addEventListener("click", (event) => {
    if (mobileMenu?.open && event.target instanceof Node && !mobileMenu.contains(event.target)) {
      mobileMenu.open = false;
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobileMenu?.open) {
      mobileMenu.open = false;
    }
  });
</script>
