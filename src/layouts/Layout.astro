---
import { getNavBarLinks, identity } from "../config";
import { normalizeLang, type Lang } from "../i18n";
import LanguageSelector from "../components/LanguageSelector.astro";
import type { PortfolioContext, SEOInfo } from "../types/config";

interface Props {
  seo: SEOInfo;
  lang?: Lang;
  context?: PortfolioContext;
}

const { seo } = Astro.props;
const pageTitle = seo.title.replace("iñaki goyeneche", "inagoy");
const url = Astro.url;
const currentUrl = url.pathname.endsWith('/') ? url.pathname.slice(0, -1) : url.pathname;
const pageLang: Lang = normalizeLang(Astro.props.lang as string | undefined);
const context = Astro.props.context ?? 'music';
const navBarLinks = getNavBarLinks(pageLang, context);
const homeHref = context === 'audio-dev' ? '/audio-dev' : `/${pageLang}/`;
function withLangPath(u: URL, lang: string): string {
  const rest = u.pathname.replace(/^\/(en|es)/, '');
  const path = `/${lang}${rest}`;
  return path;
}
const esHref = withLangPath(url, 'es');
const enHref = withLangPath(url, 'en');

---

<style is:global>
  @font-face {
    font-family: "Inter";
    src: url("/fonts/InterVariable.woff2") format("woff2");
    font-weight: 100 900;
    font-display: swap;
  }

  :root {
    --bg: #fff;
    --title-bg: transparent;
    --paper: #fff;
    --text: #111;
    --text-strong: #000;
    --muted: #686868;
    --line: #111;
    --soft: #f1f1ef;
    --accent: #111;
    --cyan: #111;
    --meta-font: ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    --yellow: #fff;
    --media-opacity: 1;
    --media-hover-opacity: 1;
  }

  html {
    background-color: var(--bg);
    color: var(--text);
    font-family: "Inter", system-ui, sans-serif;
    font-size: 15px;
    overflow-y: scroll;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  * {
    box-sizing: border-box;
    color: inherit;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
  }

  a {
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--text-strong);
    outline-offset: 3px;
  }

  .site-shell {
    width: 100%;
    min-height: 100vh;
    background: var(--paper);
    display: flex;
    flex-direction: column;
  }

  .site-shell > header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .page {
    width: 100%;
    max-width: 90rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }

  .page-header {
    margin-bottom: 2.25rem;
    padding-bottom: 1.25rem;
  }

  .page-title {
    display: block;
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .page-title.home-title {
    display: block;
    width: 100%;
    margin: 0;
    font-size: clamp(3.4rem, 10vw, 9rem);
    white-space: nowrap;
  }

  .home-role {
    margin-top: 0.85rem;
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.4;
    text-align: center;
  }

  .muted {
    color: var(--muted);
  }

  .text-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: background-color 140ms ease, color 140ms ease;
  }

  .text-link:hover,
  .text-link:focus-visible,
  .text-link:active,
  .text-link[aria-current] {
    background: transparent;
    text-decoration-thickness: 2px;
  }

  .home-links {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .primary-link {
    display: grid;
    grid-template-columns: 1fr auto;
    min-height: 3rem;
    align-items: center;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    padding: 0.6rem 0;
    color: var(--text-strong);
    font-weight: 500;
    text-decoration: none;
  }

  .primary-link::before {
    content: none;
  }

  .primary-link:nth-child(odd) {
    background: transparent;
  }

  .primary-link > div {
    display: block;
    grid-column: 2;
    grid-row: 1;
  }

  .primary-link span {
    width: fit-content;
    transition: background-color 140ms ease;
  }

  .primary-link:hover span,
  .primary-link:focus-visible span {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .project-row img,
  .music-card-cover img {
    filter: saturate(0.78) contrast(1.06);
    opacity: var(--media-opacity);
    transition: filter 180ms ease, opacity 180ms ease, transform 180ms ease;
  }

  .project-row:hover img,
  .project-row:focus-visible img,
  .music-card:hover .music-card-cover img,
  .music-card:focus-within .music-card-cover img {
    filter: saturate(1) contrast(1.03);
    opacity: var(--media-hover-opacity);
  }

  .project-row {
    display: grid;
    gap: 0.85rem;
    border-top: 2px solid var(--line);
    padding: 1.1rem 0;
  }

  .project-row > :first-child,
  .music-card-cover {
    border: 0;
    border-radius: 0 !important;
    box-shadow: none;
  }

  .kamehouse-list > .music-card-compact::before {
    background: var(--accent) !important;
  }

  .kamehouse-label {
    color: var(--text) !important;
  }

  .invalid-feedback,
  .empty-feedback {
    color: #97152e !important;
  }

  .media-project-row {
    grid-template-columns: clamp(6rem, 22vw, 9rem) minmax(0, 1fr);
    align-items: start;
    padding: 0.95rem 0;
  }

  @media (min-width: 640px) {
    html {
      font-size: 16px;
    }

    .page-header {
      margin-bottom: 3.5rem;
    }

    .page-title {
      font-size: clamp(3.5rem, 7vw, 6.5rem);
    }

    .page-title.home-title {
      font-size: clamp(4rem, 7.5vw, 7rem);
    }

    .home-role {
      font-size: 1rem;
    }

    .project-row {
      grid-template-columns: 11rem 1fr;
      gap: 1.5rem;
      padding: 1.75rem 0;
    }
  }

  .field {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--paper);
    padding: 0.75rem 0.9rem;
    color: var(--text);
    outline: none;
  }

  .field::placeholder {
    color: var(--muted);
  }

  .field:focus {
    background: var(--soft);
  }

  .button {
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--text-strong);
    padding: 0.75rem 1rem;
    color: var(--paper);
    font-weight: 600;
    transition: background-color 140ms ease, color 140ms ease;
  }

  .button:hover,
  .button:focus-visible,
  .button:active {
    background: var(--paper);
    color: var(--text-strong);
  }

  @media (min-width: 640px) {
    .field {
      padding: 0.85rem 1rem;
    }

    .button {
      padding: 0.85rem 1.1rem;
    }
  }

  @media (min-width: 640px) {
    .site-shell > header > .page {
      padding-block: 1rem;
    }
  }

  @media (max-width: 639px) {
    .site-shell {
      min-height: 100svh;
    }

    .site-shell > header {
      box-shadow: none;
    }

    .site-shell > header > .page {
      padding-block: 0.85rem 0.35rem;
    }

    .site-header {
      position: relative;
      display: block;
    }

    .site-header > a {
      display: block;
      width: fit-content;
    }

    .site-header > a img {
      height: 2.25rem;
    }

    .header-actions {
      width: 100%;
      margin-left: 0;
    }

    .site-nav {
      flex: none;
      width: calc(100% + 2rem);
      margin: 0.6rem -1rem 0;
      padding-inline: 1rem;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-nav::-webkit-scrollbar {
      display: none;
    }

    .site-nav-list {
      width: max-content;
      min-width: 100%;
      flex-wrap: nowrap;
      gap: 1.1rem;
    }

    .site-nav-list a {
      display: inline-flex;
      min-height: 2.5rem;
      align-items: center;
    }

    .page-header {
      margin-bottom: 1.75rem;
      padding-bottom: 1rem;
    }

    .page-title {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }

    .page-title.home-title {
      font-size: clamp(2.8rem, 14vw, 4rem);
      line-height: 0.86;
    }

    .page-title.home-title.portfolio-title {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .project-row {
      border-top-width: 1px;
    }

    .primary-link {
      border-bottom-width: 1px;
      min-height: 3.25rem;
    }

    .social-link {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
    }

    .field {
      font-size: 16px;
    }

    .button {
      width: 100%;
      min-height: 3rem;
    }

    .language-selector a {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
    }

    .language-selector {
      position: absolute;
      top: 0.45rem;
      right: 1rem;
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-link,
    .social-link,
    .primary-link,
    .project-row img,
    .music-card-cover img,
    .button {
      transition: none;
      animation: none;
    }
  }

  .site-shell .music-role-tag,
  .site-shell .music-artist-tag,
  .site-shell .contact-field-row:nth-child(odd),
  .site-shell .contact-submit {
    background: var(--paper);
  }

  .site-shell .contact-form-block,
  .site-shell .form-result {
    border-radius: 0;
    box-shadow: none;
  }

  .site-shell > main {
    flex: 1;
  }

  .site-nav,
  .language-selector,
  .context-links,
  .direct-links,
  .section-heading,
  .site-footer {
    font-family: var(--meta-font);
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 1.25rem;
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .portfolio-hero {
    padding-top: clamp(1.5rem, 2.5vw, 3rem);
  }

  .portfolio-title {
    border-bottom: 1px solid var(--line);
    padding-bottom: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .portfolio-identity {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    border-bottom: 1px solid var(--line);
    padding-block: clamp(1rem, 2vw, 1.5rem);
  }

  .portfolio-role {
    max-width: 34rem;
    font-family: var(--meta-font);
    font-size: clamp(1.35rem, 2.5vw, 2.4rem);
    font-weight: 500;
    letter-spacing: 0.035em;
    line-height: 1.08;
    text-transform: uppercase;
  }

  .context-links,
  .direct-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1.25rem;
    padding: 0;
    list-style: none;
  }

  .context-links a,
  .direct-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }

  .portfolio-section {
    padding-top: clamp(2.25rem, 3vw, 3.5rem);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    border-block: 1px solid var(--line);
    padding-block: 1rem;
  }

  .section-heading h2 {
    font-size: clamp(1.35rem, 2vw, 2rem);
    font-weight: 500;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 5rem) clamp(1rem, 2.5vw, 2.25rem);
    padding-top: clamp(1.5rem, 2vw, 2rem);
  }

  .secondary-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .portfolio-info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: clamp(4rem, 8vw, 8rem);
    border-top: 1px solid var(--line);
    padding-block: clamp(2rem, 4vw, 4rem);
  }

  .portfolio-info h2 {
    font-size: clamp(2.25rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .portfolio-info-copy {
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .portfolio-info-copy .direct-links {
    justify-content: flex-start;
    margin-top: 1rem;
  }

  @media (max-width: 760px) {
    .portfolio-hero {
      padding-top: 1rem;
    }

    .portfolio-title {
      padding-bottom: 0.75rem;
    }

    .portfolio-identity {
      display: block;
      padding-block: 0.85rem;
    }

    .portfolio-role {
      font-size: clamp(1.1rem, 5vw, 1.4rem);
    }

    .context-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      margin-top: 0.85rem;
      border-top: 1px solid var(--line);
      gap: 0;
    }

    .context-links li {
      min-width: 0;
      border-bottom: 1px solid var(--line);
    }

    .context-links li:nth-child(odd) {
      border-right: 1px solid var(--line);
    }

    .context-links li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      border-right: 0;
    }

    .context-links a {
      width: 100%;
      padding-inline: 0.15rem;
      overflow-wrap: anywhere;
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2rem, 8vw, 3rem) 0.75rem;
      padding-top: 1.25rem;
    }

    .portfolio-section {
      padding-top: 2.5rem;
    }

    .section-heading {
      align-items: flex-end;
      padding-block: 0.8rem;
    }

    .section-heading h2 {
      font-size: clamp(1.3rem, 6vw, 1.75rem);
      line-height: 1;
    }

    .section-heading .text-link {
      flex: none;
      max-width: 45%;
      font-size: 0.78rem;
      line-height: 1.25;
      text-align: right;
    }

    .portfolio-info {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-top: 4rem;
      padding-block: 1.5rem 2.5rem;
    }

    .portfolio-info h2 {
      font-size: clamp(2.5rem, 13vw, 4rem);
    }

    .portfolio-info-copy .direct-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1rem;
      margin-top: 1.25rem;
      border-top: 1px solid var(--line);
    }

    .portfolio-info-copy .direct-links li {
      border-bottom: 1px solid var(--line);
    }

    .portfolio-info-copy .direct-links a {
      width: 100%;
      overflow-wrap: anywhere;
    }
  }

  @media (max-width: 480px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer a {
      overflow-wrap: anywhere;
    }

    .site-footer .page {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>

<html lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={seo.description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    
  </head>
  <body>
    <div class="site-shell">
      <header>
        <div class="site-header page flex items-center justify-between py-4 sm:py-9">
          <a href={homeHref} class="text-link text-sm">
            <img
              src={identity.logo}
              alt={identity.name}
              width="46"
              height="46"
              class="block h-10 w-auto brightness-0 sm:h-14"
            />
          </a>
          <div class="header-actions ml-auto flex items-center gap-2 sm:gap-5">
            <nav class="site-nav flex items-center text-xs sm:text-sm" aria-label="Primary">
              <ul class="site-nav-list flex items-center gap-2 sm:gap-5">
                {
                  navBarLinks.map((link) => (
                    <li>
                      <a
                        class="text-link whitespace-nowrap"
                        href={link.url}
                        target={link.external ? "_blank" : "_self"}
                        rel={link.external ? "noopener noreferrer" : undefined}
                        aria-current={currentUrl === link.url ? "page" : undefined}
                      >
                        {link.title}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
            {currentUrl !== '/audio-dev' && <LanguageSelector lang={pageLang} esHref={esHref} enHref={enHref} />}
          </div>
        </div>
      </header>
      <main class="pb-8 sm:pb-14">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="page flex flex-wrap items-center justify-between gap-4">
          <p>© {new Date().getFullYear()} {identity.name}</p>
          <a class="text-link" href={`mailto:${identity.email}`}>{identity.email}</a>
        </div>
      </footer>
    </div>
  </body>
</html>
