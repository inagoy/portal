---
import { Image } from "astro:assets";
import type { MusicProject, Project } from "../types/config";
import { getMusicProjectSlug, participants } from "../config";
import { getStrings, normalizeLang, type Lang } from "../i18n";
import { getInlineMedia } from "../utils/media.mjs";

type Props = Omit<Project, "description"> & {
  artist?: string;
  description?: string;
  roles?: MusicProject["roles"];
  artistRoles?: MusicProject["artistRoles"];
  collaborators?: MusicProject["collaborators"];
  lang?: Lang;
  compact?: boolean;
};
const {
  title,
  artist,
  description,
  image,
  year,
  url,
  embedUrl,
  collaborators = [],
  lang,
  type,
  roles = [],
  artistRoles = [],
  compact = false,
} = Astro.props as Props;
const currentLang = normalizeLang(lang);
const t = getStrings(currentLang);
const detailUrl = `/${currentLang}/music-projects/${getMusicProjectSlug({ title })}`;
const frameTitles =
  currentLang === "es"
    ? {
        spotify: "reproductor de spotify",
        youtube: "reproductor de youtube",
        bandcamp: "reproductor de bandcamp",
      }
    : {
        spotify: "spotify player",
        youtube: "youtube player",
        bandcamp: "bandcamp player",
      };

const inlineMedia = getInlineMedia(embedUrl ?? url);
const showInlinePlayer: boolean = false;
const isYouTubeProject = inlineMedia?.platform === "youtube";
const coverFrameClass = [
  "relative aspect-square rounded-[2px]",
  isYouTubeProject ? "bg-transparent" : "bg-[var(--soft)]",
].join(" ");
const coverImageClass = [
  "h-full w-full object-cover transition duration-300",
  isYouTubeProject ? "youtube-cover-image" : "group-hover/card:scale-[1.03]",
].join(" ");
const roleLabels = roles.map((role) => t.labels.roles[role] ?? role);
const artistRoleLabels = artistRoles.map((role) => t.labels.artistRoles[role] ?? role);
const projectParticipants = collaborators.map((id) => participants[id]);
const collaboratorSeparator = currentLang === "es" ? "y" : "&";
const roleListLabel = currentLang === "es" ? "roles del proyecto" : "project roles";
const artistRoleListLabel = currentLang === "es" ? "como artista" : "as an artist";
const albumClass = type === "album" ? "music-card-album" : "";
const projectClass = type ? "music-card-project" : "";
const cardClass = [
  "music-card group/card border-t border-[var(--line)] py-5 sm:py-6",
  albumClass,
  projectClass,
  compact ? "music-card-compact" : "",
].join(" ");
const linkClass = [
  "music-card project-row media-project-row group/card",
  albumClass,
  projectClass,
  compact ? "music-card-compact" : "",
].join(" ");
---

{
  showInlinePlayer && inlineMedia ? (
    <details class={cardClass}>
      <summary class="music-card-summary grid cursor-pointer gap-[0.85rem] sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-4">
        <div class={`music-card-cover ${coverFrameClass}`}>
          <div class="h-full w-full overflow-hidden">
            <Image
              width={1920}
              height={1080}
              src={image}
              alt={title}
              class={coverImageClass}
            />
          </div>
        </div>
        <div class="music-card-content min-w-0">
          {artist && <p class="music-card-artist mb-1 font-semibold">{artist}</p>}
          <div class="flex items-start justify-between gap-3 sm:gap-4">
            <h2 class="text-[0.98rem] font-bold leading-tight sm:text-base">
              {title}
            </h2>
            {year && <p class="muted shrink-0 text-xs font-bold sm:text-sm">{year}</p>}
          </div>
          {roleLabels.length > 0 && (
            <ul class="music-role-tags mt-3 sm:mt-2" aria-label={roleListLabel}>
              {roleLabels.map((role) => (
                <li class="music-role-tag">{role}</li>
              ))}
            </ul>
          )}
          {description && roleLabels.length === 0 && (
            <p class="muted mt-1.5 text-sm sm:mt-2 sm:text-base">{description}</p>
          )}
          {artistRoleLabels.length > 0 && (
            <ul class="music-artist-tags mt-2.5 sm:mt-1.5" aria-label={artistRoleListLabel}>
              {artistRoleLabels.map((role) => (
                <li class="music-artist-tag">{role}</li>
              ))}
            </ul>
          )}
          {projectParticipants.length > 0 && (
            <p class="music-card-extra text-xs sm:text-sm">
              <span class="uppercase">{t.labels.with}</span>
              {projectParticipants.map((participant, index) => (
                <>
                  {index > 0 && <span class="uppercase">{collaboratorSeparator}</span>}
                  <a class="underline underline-offset-2 uppercase" href={participant.instagram} target="_blank" rel="noopener noreferrer">
                    {participant.name}
                  </a>
                </>
              ))}
            </p>
          )}
        </div>
        {type && (
          <p class="music-type-banner">
            {t.labels.types?.[type] ?? type}
          </p>
        )}
      </summary>
      <div class="music-card-player mt-3 flex w-full justify-center">
        <div class="w-full">
          {
            inlineMedia.platform === "youtube" ? (
              <div class="player-shell aspect-video overflow-hidden" data-player-shell>
                <div class="player-loading" aria-hidden="true">
                  <span class="player-dots"></span>
                </div>
                <iframe
                  class="h-full w-full"
                  data-player-frame
                  data-player-src={inlineMedia.embedUrl}
                  title={`${title} | ${frameTitles[inlineMedia.platform]}`}
                  loading="lazy"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              </div>
            ) : (
              <div class="player-shell overflow-hidden" style={inlineMedia.maxWidth ? `max-width: ${inlineMedia.maxWidth}px; margin-inline: auto;` : undefined} data-player-shell>
                <div class="player-loading" aria-hidden="true">
                  <span class="player-dots"></span>
                </div>
                <iframe
                  class="block w-full overflow-hidden"
                  data-player-frame
                  data-player-src={inlineMedia.embedUrl}
                  title={`${title} | ${frameTitles[inlineMedia.platform]}`}
                  loading="lazy"
                  width="100%"
                  height={inlineMedia.height}
                  allow="clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                ></iframe>
              </div>
            )
          }
        </div>
      </div>
    </details>
  ) : (
    <article class={linkClass}>
      <a class="music-card-link" href={detailUrl} aria-label={`${artist ? `${artist} — ` : ""}${title}`}></a>
      <div class={`music-card-cover ${coverFrameClass}`}>
        <div class="h-full w-full overflow-hidden">
          <Image
            width={1920}
            height={1080}
            src={image}
            alt={title}
            class={coverImageClass}
          />
        </div>
      </div>
      <div class="music-card-content min-w-0">
        <div class="music-card-heading">
          <div class="min-w-0">
            {artist && <p class="music-card-artist mb-1 font-semibold">{artist}</p>}
            <h2 class="text-[0.98rem] font-bold leading-tight sm:text-base">
              {title}
            </h2>
          </div>
          <div class="music-card-facts">
            {type && (
              <span class="music-card-type">{t.labels.types?.[type] ?? type}</span>
            )}
            {year && <span class="music-card-year">{year}</span>}
          </div>
        </div>
        <div class="music-card-lower">
          <div class="music-card-role-stack">
            {roleLabels.length > 0 && (
              <ul class="music-role-tags" aria-label={roleListLabel}>
                {roleLabels.map((role) => (
                  <li class="music-role-tag">{role}</li>
                ))}
              </ul>
            )}
            {description && roleLabels.length === 0 && (
              <p class="muted text-sm sm:text-base">{description}</p>
            )}
            {artistRoleLabels.length > 0 && (
              <ul class="music-artist-tags" aria-label={artistRoleListLabel}>
                {artistRoleLabels.map((role) => (
                  <li class="music-artist-tag">{role}</li>
                ))}
              </ul>
            )}
          </div>
          {projectParticipants.length > 0 && (
            <p class="music-card-extra text-xs sm:text-sm">
              <span class="uppercase">{t.labels.with}</span>
              {projectParticipants.map((participant, index) => (
                <>
                  {index > 0 && <span class="uppercase">{collaboratorSeparator}</span>}
                  <a class="underline underline-offset-2 uppercase" href={participant.instagram} target="_blank" rel="noopener noreferrer">
                    {participant.name}
                  </a>
                </>
              ))}
            </p>
          )}
        </div>
      </div>
    </article>
  )
}

<style>
  details > summary {
    list-style: none;
  }

  details > summary::-webkit-details-marker {
    display: none;
  }

  .music-role-tags,
  .music-artist-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    color: var(--text);
    font-family: var(--meta-font);
    font-size: 0.7rem;
    letter-spacing: 0.045em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .music-role-tag,
  .music-artist-tag {
    border-radius: 2px;
    background: var(--text);
    color: var(--paper);
    font-size: inherit;
    font-weight: 500;
    line-height: 1.2;
    padding: 0.25rem 0.42rem;
  }

  .music-artist-tag {
    background: var(--soft);
    color: var(--text);
  }

  .music-card-artist {
    color: var(--muted);
    font-size: clamp(1.75rem, 3.5vw, 2.4rem);
    line-height: 1.15;
  }

  .music-card-content {
    display: flex;
    align-self: stretch;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }

  .music-card-heading,
  .music-card-lower {
    display: flex;
    justify-content: space-between;
    gap: clamp(1rem, 3vw, 3rem);
  }

  .music-card-heading {
    align-items: flex-start;
  }

  .music-card-lower {
    align-items: flex-end;
    margin-top: auto;
    padding-top: 1rem;
  }

  .music-card-role-stack {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .music-card-facts {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.75rem;
  }

  .music-card-type,
  .music-card-year {
    font-family: var(--meta-font);
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .music-card-type {
    border-radius: 2px;
    background: var(--soft);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.3rem 0.42rem;
  }

  .music-card-year {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .music-card-extra {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 20rem;
    gap: 0.18rem 0.28rem;
    color: var(--muted);
    font-family: var(--meta-font);
    letter-spacing: 0.035em;
    text-align: right;
  }

  .music-type-banner {
    position: absolute;
    top: 1.6rem;
    left: 0.4rem;
    z-index: 2;
    background: var(--paper);
    color: var(--text);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    padding: 0.3rem 0.4rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .music-card {
    position: relative;
  }

  .music-card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  details.music-card-project {
    --music-card-padding: 1.25rem;
  }

  details.music-card-project.music-card-compact {
    --music-card-padding: 1.15rem;
  }

  details.music-card-project .music-type-banner {
    top: calc(-1 * var(--music-card-padding));
  }


  .music-card.media-project-row {
    border-top-width: 1px;
    padding-block: 1.25rem;
  }

  .music-card-album {
    --media-opacity: 0.96;
    --media-hover-opacity: 1;
  }

  .music-card-album h2 {
    color: var(--text-strong);
  }

  .music-card-album img {
    filter: saturate(1.08) contrast(1.03);
  }

  details.music-card-compact {
    padding-block: 1.15rem;
  }

  .music-card-compact summary h2 {
    font-size: 0.92rem;
  }

  .music-card-compact summary .muted {
    font-size: 0.74rem;
  }

  @media (min-width: 640px) {
    details.music-card-compact {
      padding-block: 1rem;
    }

    details.music-card-project {
      --music-card-padding: 1.5rem;
    }

    details.music-card-project.music-card-compact {
      --music-card-padding: 1rem;
    }

    details.music-card-compact .music-card-summary {
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }

    .music-card.media-project-row {
      grid-template-columns: 11rem minmax(0, 1fr);
      align-items: stretch;
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }

    .music-card-compact.media-project-row {
      grid-template-columns: 8rem minmax(0, 1fr);
    }

    .music-card-compact summary h2 {
      font-size: 0.94rem;
    }

  }

  @media (max-width: 639px) {
    .music-card-heading,
    .music-card-lower {
      display: block;
    }

    .music-card-facts {
      width: fit-content;
      margin-top: 0.65rem;
    }

    .music-card-lower {
      padding-top: 0.75rem;
    }

    .music-card-extra {
      justify-content: flex-start;
      max-width: none;
      margin-top: 0.65rem;
      font-size: clamp(0.65rem, 2.8vw, 0.75rem);
      text-align: left;
    }

    .music-card-summary {
      grid-template-columns: clamp(4.5rem, 22vw, 5.5rem) minmax(0, 1fr);
      align-items: start;
    }

  }

  details[open].music-card {
    margin-block: 0.75rem 2rem;
    border: 1px solid var(--line);
    background: var(--paper);
    padding: clamp(0.9rem, 2vw, 1.4rem);
  }

  details[open].music-card .music-type-banner {
    display: none;
  }

  .music-card-player {
    position: relative;
    margin-top: 1.25rem !important;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  details[open] .music-card-player {
    animation: music-player-reveal 320ms ease both;
  }

  .youtube-cover-image {
    transform: scale(1.34);
    transform-origin: center;
  }

  .music-card:hover .youtube-cover-image,
  .media-project-row:hover .youtube-cover-image {
    transform: scale(1.38);
  }

  .player-shell {
    position: relative;
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
    overflow: hidden;
    background: transparent;
  }

  .player-shell iframe {
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .player-loading {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: center;
    padding-top: 0.6rem;
    color: var(--muted);
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .player-dots::after {
    content: ".";
    font-size: 1.15rem;
    letter-spacing: 0.18em;
    animation: player-dots 1s steps(1, end) infinite;
  }

  .player-shell[data-loaded="true"] iframe {
    opacity: 1;
  }

  .player-shell[data-loaded="true"] .player-loading {
    opacity: 0;
  }

  @keyframes player-dots {
    0%,
    24% {
      content: ".";
    }

    25%,
    49% {
      content: "..";
    }

    50%,
    74% {
      content: "...";
    }

    75%,
    100% {
      content: ".";
    }
  }

  @keyframes music-player-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.4rem) scale(0.99);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details[open] .music-card-player {
      animation: none;
    }
  }
</style>

<script is:inline>
  if (!window.__musicPlayerLoaderInit) {
    window.__musicPlayerLoaderInit = true;

    const bindMusicPlayerInteractions = () => {
      const getPlayerFrame = (card) => {
        const shell = card.querySelector("[data-player-shell]");

        if (!(shell instanceof HTMLElement)) {
          return null;
        }

        const frame = shell.querySelector("[data-player-frame]");

        if (!(frame instanceof HTMLIFrameElement)) {
          shell.dataset.loaded = "true";
          return null;
        }

        return { shell, frame };
      };

      const loadPlayer = (card) => {
        const player = getPlayerFrame(card);

        if (!player) {
          return;
        }

        const { shell, frame } = player;
        const playerSrc = frame.dataset.playerSrc;

        if (!playerSrc) {
          shell.dataset.loaded = "true";
          return;
        }

        if (frame.getAttribute("src") === playerSrc) {
          return;
        }

        shell.dataset.loaded = "false";
        frame.setAttribute("src", playerSrc);
      };

      const unloadPlayer = (card) => {
        const player = getPlayerFrame(card);

        if (!player) {
          return;
        }

        const { shell, frame } = player;

        shell.dataset.loaded = "false";

        if (frame.getAttribute("src")) {
          frame.removeAttribute("src");
        }
      };

      document.querySelectorAll("[data-player-shell]").forEach((shell) => {
        if (!(shell instanceof HTMLElement) || shell.dataset.bound === "true") {
          return;
        }

        shell.dataset.bound = "true";
        const frame = shell.querySelector("[data-player-frame]");

        if (!(frame instanceof HTMLIFrameElement)) {
          shell.dataset.loaded = "true";
          return;
        }

        frame.addEventListener(
          "load",
          () => {
            if (frame.getAttribute("src") === frame.dataset.playerSrc) {
              shell.dataset.loaded = "true";
            }
          },
        );
      });

      document.querySelectorAll("details.music-card").forEach((card) => {
        if (!(card instanceof HTMLDetailsElement) || card.dataset.toggleBound === "true") {
          return;
        }

        card.dataset.toggleBound = "true";
        if (card.open) {
          loadPlayer(card);
        } else {
          unloadPlayer(card);
        }

        card.addEventListener("toggle", () => {
          if (card.open) {
            document.querySelectorAll("details.music-card[open]").forEach((openCard) => {
              if (openCard instanceof HTMLDetailsElement && openCard !== card) {
                unloadPlayer(openCard);
                openCard.open = false;
              }
            });

            loadPlayer(card);
            return;
          }

          unloadPlayer(card);
        });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bindMusicPlayerInteractions, { once: true });
    } else {
      bindMusicPlayerInteractions();
    }
  }
</script>
