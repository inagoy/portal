---
import { Image } from "astro:assets";
import type { MusicProject, Project } from "../types/config";
import { getStrings, normalizeLang, type Lang } from "../i18n";

type Props = Omit<Project, "description"> & {
  description?: string;
  roles?: MusicProject["roles"];
  artistRoles?: MusicProject["artistRoles"];
  lang?: Lang;
  compact?: boolean;
};
type InlineMedia = {
  platform: "spotify" | "youtube";
  embedUrl: string;
  frameTitle: string;
  height?: number;
};

const {
  title,
  description,
  image,
  year,
  url,
  socio,
  lang,
  type,
  roles = [],
  artistRoles = [],
  compact = false,
} = Astro.props as Props;
const currentLang = normalizeLang(lang);
const t = getStrings(currentLang);
const frameTitles =
  currentLang === "es"
    ? {
        spotify: "reproductor de spotify",
        youtube: "reproductor de youtube",
      }
    : {
        spotify: "spotify player",
        youtube: "youtube player",
      };

function getInlineMedia(projectUrl: string): InlineMedia | null {
  try {
    const parsedUrl = new URL(projectUrl);
    const hostname = parsedUrl.hostname.replace(/^www\./, "");

    if (hostname === "open.spotify.com") {
      const segments = parsedUrl.pathname.split("/").filter(Boolean);
      const mediaIndex = segments.findIndex((segment) =>
        ["album", "track", "playlist", "episode", "show"].includes(segment),
      );
      const mediaType = segments[mediaIndex];
      const mediaId = segments[mediaIndex + 1];

      if (mediaType && mediaId) {
        return {
          platform: "spotify",
          embedUrl: `https://open.spotify.com/embed/${mediaType}/${mediaId}?utm_source=generator&theme=0`,
          frameTitle: frameTitles.spotify,
          height: mediaType === "track" || mediaType === "episode" ? 152 : mediaType === "album" ? 480 : 352,
        };
      }
    }

    if (hostname === "youtube.com" || hostname === "m.youtube.com") {
      const videoId = parsedUrl.searchParams.get("v");

      if (videoId) {
        return {
          platform: "youtube",
          embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`,
          frameTitle: frameTitles.youtube,
        };
      }
    }

    if (hostname === "youtu.be") {
      const videoId = parsedUrl.pathname.split("/").filter(Boolean)[0];

      if (videoId) {
        return {
          platform: "youtube",
          embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`,
          frameTitle: frameTitles.youtube,
        };
      }
    }
  } catch {
    return null;
  }

  return null;
}

const inlineMedia = getInlineMedia(url);
const isYouTubeProject = inlineMedia?.platform === "youtube";
const coverFrameClass = [
  "relative aspect-square rounded-[2px]",
  isYouTubeProject ? "bg-transparent" : "bg-[var(--soft)]",
].join(" ");
const coverImageClass = [
  "h-full w-full object-cover transition duration-300",
  isYouTubeProject ? "youtube-cover-image" : "group-hover/card:scale-[1.03]",
].join(" ");
const roleLabels = roles.map((role) => t.labels.roles[role] ?? role);
const artistRoleLabels = artistRoles.map((role) => t.labels.artistRoles[role] ?? role);
const collaboratorParts = socio?.split(/(\s+(?:y|&)\s+)/i) ?? [];
const roleListLabel = currentLang === "es" ? "roles del proyecto" : "project roles";
const artistRoleListLabel = currentLang === "es" ? "roles artísticos" : "artist roles";
const albumClass = type === "album" ? "music-card-album" : "";
const cardClass = [
  "music-card group/card border-t border-[var(--line)] py-5 sm:py-6",
  albumClass,
  compact ? "music-card-compact" : "",
].join(" ");
const linkClass = [
  "music-card project-row media-project-row group/card",
  albumClass,
  compact ? "music-card-compact" : "",
].join(" ");
---

{
  inlineMedia ? (
    <details class={cardClass}>
      <div class="music-card-overlay" aria-hidden="true"></div>
      <summary class="music-card-summary grid cursor-pointer gap-[0.85rem] sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-4">
        <div class={`music-card-cover ${coverFrameClass}`}>
          <div class="h-full w-full overflow-hidden">
            <Image
              width={1920}
              height={1080}
              src={image}
              alt={title}
              class={coverImageClass}
            />
          </div>
          {type && (
            <p class="music-type-banner" data-type={type}>
              {t.labels.types?.[type] ?? type}
            </p>
          )}
        </div>
        <div class="music-card-content min-w-0">
          <div class="flex items-start justify-between gap-3 sm:gap-4">
            <h2 class="text-[0.98rem] font-bold leading-tight sm:text-base">
              {title}
            </h2>
            {year && <p class="muted shrink-0 text-xs font-bold sm:text-sm">{year}</p>}
          </div>
          {roleLabels.length > 0 && (
            <ul class="music-role-tags mt-3 sm:mt-2" aria-label={roleListLabel}>
              {roleLabels.map((role) => (
                <li class="music-role-tag text-xs sm:text-sm">{role}</li>
              ))}
            </ul>
          )}
          {description && roleLabels.length === 0 && (
            <p class="muted mt-1.5 text-sm sm:mt-2 sm:text-base">{description}</p>
          )}
          {artistRoleLabels.length > 0 && (
            <ul class="music-artist-tags mt-2.5 sm:mt-1.5" aria-label={artistRoleListLabel}>
              {artistRoleLabels.map((role) => (
                <li class="music-artist-tag text-xs sm:text-sm">{role}</li>
              ))}
            </ul>
          )}
          {socio && (
            <p class="music-card-extra text-xs sm:text-sm">
              <span class="uppercase">{t.labels.with}</span>
              {collaboratorParts.map((part, index) => (
                <span class={index % 2 ? "uppercase" : "underline underline-offset-2 uppercase"}>{part.trim()}</span>
              ))}
            </p>
          )}
        </div>
      </summary>
      <div class="music-card-player mt-3 flex w-full justify-center">
        <div class="w-full">
          {
            inlineMedia.platform === "youtube" ? (
              <div class="player-shell aspect-video overflow-hidden" data-player-shell>
                <div class="player-loading" aria-hidden="true">
                  <span class="player-dots"></span>
                </div>
                <iframe
                  class="h-full w-full"
                  data-player-frame
                  data-player-src={inlineMedia.embedUrl}
                  title={`${title} | ${inlineMedia.frameTitle}`}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              </div>
            ) : (
              <div class="player-shell overflow-hidden" data-player-shell>
                <div class="player-loading" aria-hidden="true">
                  <span class="player-dots"></span>
                </div>
                <iframe
                  class="block w-full overflow-hidden"
                  data-player-frame
                  data-player-src={inlineMedia.embedUrl}
                  title={`${title} | ${inlineMedia.frameTitle}`}
                  loading="lazy"
                  width="100%"
                  height={inlineMedia.height}
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                ></iframe>
              </div>
            )
          }
        </div>
      </div>
    </details>
  ) : (
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class={linkClass}
    >
      <div class={`music-card-cover ${coverFrameClass}`}>
        <div class="h-full w-full overflow-hidden">
          <Image
            width={1920}
            height={1080}
            src={image}
            alt={title}
            class={coverImageClass}
          />
        </div>
        {type && (
          <p class="music-type-banner" data-type={type}>
            {t.labels.types?.[type] ?? type}
          </p>
        )}
      </div>
      <div class="music-card-content min-w-0">
        <div class="flex items-start justify-between gap-3 sm:gap-4">
          <h2 class="text-[0.98rem] font-bold leading-tight sm:text-base">
            {title}
          </h2>
          {year && <p class="muted shrink-0 text-xs font-bold sm:text-sm">{year}</p>}
        </div>
        {roleLabels.length > 0 && (
          <ul class="music-role-tags mt-3 sm:mt-2" aria-label={roleListLabel}>
            {roleLabels.map((role) => (
              <li class="music-role-tag text-xs sm:text-sm">{role}</li>
            ))}
          </ul>
        )}
        {description && roleLabels.length === 0 && (
          <p class="muted mt-1.5 text-sm sm:mt-2 sm:text-base">{description}</p>
        )}
        {artistRoleLabels.length > 0 && (
          <ul class="music-artist-tags mt-2.5 sm:mt-1.5" aria-label={artistRoleListLabel}>
            {artistRoleLabels.map((role) => (
              <li class="music-artist-tag text-xs sm:text-sm">{role}</li>
            ))}
          </ul>
        )}
        {socio && (
          <p class="music-card-extra text-xs sm:text-sm">
            <span class="uppercase">{t.labels.with}</span>
            {collaboratorParts.map((part, index) => (
              <span class={index % 2 ? "uppercase" : "underline underline-offset-2 uppercase"}>{part.trim()}</span>
            ))}
          </p>
        )}
      </div>
    </a>
  )
}

<style>
  details > summary {
    list-style: none;
  }

  details > summary::-webkit-details-marker {
    display: none;
  }

  .music-role-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.35rem;
    list-style: none;
  }

  .music-artist-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.4rem;
    list-style: none;
  }

  .music-role-tag {
    background: rgb(78 143 82 / 0.82);
    color: var(--text-strong);
    font-weight: 650;
    line-height: 1.2;
    padding: 0 0.12rem 0.04rem;
  }

  .music-artist-tag {
    background: color-mix(in srgb, var(--yellow) 22%, var(--paper));
    color: var(--text-strong);
    font-weight: 650;
    line-height: 1.2;
    padding: 0 0.12rem 0.04rem;
  }

  .music-card-content {
    display: flex;
    align-self: stretch;
    flex-direction: column;
  }

  .music-card-extra {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.18rem 0.28rem;
    margin-top: auto;
    padding-top: 0.75rem;
    text-align: right;
  }

  .music-type-banner {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    border-right: 1.5px solid var(--line);
    border-bottom: 1.5px solid var(--line);
    background: var(--paper);
    padding: 0.11rem 0.34rem 0.14rem;
    color: var(--text-strong);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .music-type-banner[data-type="album"] {
    background: var(--accent);
  }

  .music-type-banner[data-type="single"] {
    background: color-mix(in srgb, var(--yellow) 55%, var(--paper));
  }

  .music-type-banner[data-type="audiovisual"] {
    background: color-mix(in srgb, var(--cyan) 55%, var(--paper));
  }

  .music-card {
    position: relative;
  }

  details.music-card:not(.music-card-compact) {
    --music-card-content-offset: calc(clamp(4.5rem, 22vw, 5.5rem) + 0.85rem);
  }

  details.music-card-album:not(.music-card-compact) {
    --music-card-content-offset: calc(clamp(5.8rem, 31vw, 7rem) + 1rem);
  }

  .music-card.media-project-row {
    border-top-width: 1px;
    padding-block: 1.25rem;
  }

  .music-card-album {
    --media-opacity: 0.96;
    --media-hover-opacity: 1;
  }

  .music-card-album h2 {
    color: var(--text-strong);
  }

  .music-card-album img {
    filter: saturate(1.08) contrast(1.03);
  }

  details.music-card-compact {
    padding-block: 1.15rem;
    transition: margin-left 320ms ease, width 320ms ease, padding-block 320ms ease;
  }

  .music-card-compact summary h2 {
    font-size: 0.92rem;
  }

  .music-card-compact summary .muted,
  .music-card-compact .music-role-tag,
  .music-card-compact .music-artist-tag {
    font-size: 0.74rem;
  }

  @media (min-width: 640px) {
    details.music-card:not(.music-card-compact) {
      --music-card-content-offset: 9rem;
    }

    details.music-card-album:not(.music-card-compact) {
      --music-card-content-offset: 10rem;
    }

    details.music-card-compact {
      padding-block: 1rem;
    }

    details.music-card-compact .music-card-summary,
    .music-card-compact.media-project-row {
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }

    .music-card-compact summary h2 {
      font-size: 0.94rem;
    }

    details.music-card-album:not(.music-card-compact) .music-card-summary,
    .music-card-album.media-project-row:not(.music-card-compact) {
      grid-template-columns: 9rem minmax(0, 1fr);
    }

    details.music-card-album.music-card-compact .music-card-summary,
    .music-card-album.music-card-compact.media-project-row {
      grid-template-columns: 7.6rem minmax(0, 1fr);
    }
  }

  @media (max-width: 639px) {
    .music-card-summary {
      grid-template-columns: clamp(4.5rem, 22vw, 5.5rem) minmax(0, 1fr);
      align-items: start;
    }

    details.music-card-album .music-card-summary,
    .music-card-album.media-project-row {
      grid-template-columns: clamp(5.8rem, 31vw, 7rem) minmax(0, 1fr);
      gap: 1rem;
    }
  }

  details.music-card-album,
  .music-card-album.media-project-row {
    padding-block: 1.5rem;
  }

  details.music-card-album.music-card-compact {
    padding-block: 1.25rem;
  }

  @media (min-width: 640px) {
    details.music-card-album,
    .music-card-album.media-project-row {
      padding-block: 1.85rem;
    }

    details.music-card-album.music-card-compact {
      padding-block: 1.25rem;
    }
  }

  .music-card-overlay {
    display: none;
  }

  details[open].music-card-compact {
    margin-left: calc(-1 * var(--music-card-player-pull, 0rem));
    width: calc(100% + var(--music-card-player-pull, 0rem));
  }

  details[open].music-card {
    z-index: 20;
  }

  details[open].music-card:not(.music-card-compact) .music-card-content {
    animation: music-card-content-slide 320ms ease both;
  }

  details[open].music-card .music-card-overlay {
    position: fixed;
    inset: 0;
    display: block;
    background: rgba(47, 20, 11, 0.48);
    pointer-events: none;
  }

  .music-card-summary,
  .music-card-player {
    position: relative;
    z-index: 1;
  }

  details[open] .music-card-player {
    animation: music-player-reveal 320ms ease both;
  }

  details[open].music-card .music-card-summary {
    grid-template-columns: minmax(0, 1fr);
  }

  details[open] .music-card-cover {
    display: none;
  }

  details[open] .music-card-extra {
    display: none;
  }

  .youtube-cover-image {
    transform: scale(1.34);
    transform-origin: center;
  }

  .music-card:hover .youtube-cover-image,
  .media-project-row:hover .youtube-cover-image {
    transform: scale(1.38);
  }

  .player-shell {
    position: relative;
  }

  .player-shell iframe {
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .player-loading {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: center;
    padding-top: 0.6rem;
    color: var(--muted);
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .player-dots::after {
    content: ".";
    font-size: 1.15rem;
    letter-spacing: 0.18em;
    animation: player-dots 1s steps(1, end) infinite;
  }

  .player-shell[data-loaded="true"] iframe {
    opacity: 1;
  }

  .player-shell[data-loaded="true"] .player-loading {
    opacity: 0;
  }

  @keyframes player-dots {
    0%,
    24% {
      content: ".";
    }

    25%,
    49% {
      content: "..";
    }

    50%,
    74% {
      content: "...";
    }

    75%,
    100% {
      content: ".";
    }
  }

  @keyframes music-player-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.4rem) scale(0.99);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes music-card-content-slide {
    from {
      transform: translateX(var(--music-card-content-offset));
    }

    to {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details.music-card-compact {
      transition: none;
    }

    details[open] .music-card-player,
    details[open].music-card:not(.music-card-compact) .music-card-content {
      animation: none;
    }
  }
</style>

<script is:inline>
  if (!window.__musicPlayerLoaderInit) {
    window.__musicPlayerLoaderInit = true;

    const bindMusicPlayerInteractions = () => {
      const getPlayerFrame = (card) => {
        const shell = card.querySelector("[data-player-shell]");

        if (!(shell instanceof HTMLElement)) {
          return null;
        }

        const frame = shell.querySelector("[data-player-frame]");

        if (!(frame instanceof HTMLIFrameElement)) {
          shell.dataset.loaded = "true";
          return null;
        }

        return { shell, frame };
      };

      const loadPlayer = (card) => {
        const player = getPlayerFrame(card);

        if (!player) {
          return;
        }

        const { shell, frame } = player;
        const playerSrc = frame.dataset.playerSrc;

        if (!playerSrc) {
          shell.dataset.loaded = "true";
          return;
        }

        if (frame.getAttribute("src") === playerSrc) {
          return;
        }

        shell.dataset.loaded = "false";
        frame.setAttribute("src", playerSrc);
      };

      const unloadPlayer = (card) => {
        const player = getPlayerFrame(card);

        if (!player) {
          return;
        }

        const { shell, frame } = player;

        shell.dataset.loaded = "false";

        if (frame.getAttribute("src")) {
          frame.removeAttribute("src");
        }
      };

      document.querySelectorAll("[data-player-shell]").forEach((shell) => {
        if (!(shell instanceof HTMLElement) || shell.dataset.bound === "true") {
          return;
        }

        shell.dataset.bound = "true";
        const frame = shell.querySelector("[data-player-frame]");

        if (!(frame instanceof HTMLIFrameElement)) {
          shell.dataset.loaded = "true";
          return;
        }

        frame.addEventListener(
          "load",
          () => {
            if (frame.getAttribute("src") === frame.dataset.playerSrc) {
              shell.dataset.loaded = "true";
            }
          },
        );
      });

      document.querySelectorAll("details.music-card").forEach((card) => {
        if (!(card instanceof HTMLDetailsElement) || card.dataset.toggleBound === "true") {
          return;
        }

        card.dataset.toggleBound = "true";
        if (card.open) {
          loadPlayer(card);
        } else {
          unloadPlayer(card);
        }

        card.addEventListener("toggle", () => {
          if (card.open) {
            document.querySelectorAll("details.music-card[open]").forEach((openCard) => {
              if (openCard instanceof HTMLDetailsElement && openCard !== card) {
                unloadPlayer(openCard);
                openCard.open = false;
              }
            });

            loadPlayer(card);
            return;
          }

          unloadPlayer(card);
        });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bindMusicPlayerInteractions, { once: true });
    } else {
      bindMusicPlayerInteractions();
    }
  }
</script>
