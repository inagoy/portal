---
import type { SoftwareProject } from "../types/config";
import type { Lang } from "../i18n";
import { getSoftwareProjectSlug } from "../config";

interface Props {
  project: SoftwareProject;
  lang?: Lang;
  compact?: boolean;
}

const { project, lang, compact = false } = Astro.props;
const detailUrl = lang ? `/${lang}/audio-dev/${getSoftwareProjectSlug(project)}` : undefined;
const primaryUrl = detailUrl ?? project.demo ?? project.repository;
const demoLabel = project.demo?.includes("youtu") ? "youtube ↗" : "demo ↗";
---

<article class:list={["software-card", { compact }]}>
  {
    primaryUrl ? (
      <a
        class="software-image"
        href={primaryUrl}
        target={detailUrl ? undefined : "_blank"}
        rel={detailUrl ? undefined : "noopener noreferrer"}
        aria-label={project.name}
      >
        <img src={project.image} alt={`${project.name} interface`} loading="lazy" decoding="async" />
      </a>
    ) : (
      <div class="software-image">
        <img src={project.image} alt={`${project.name} interface`} loading="lazy" decoding="async" />
      </div>
    )
  }
  <div class="software-heading">
    <h3>{detailUrl ? <a href={detailUrl}>{project.name}</a> : project.name}</h3>
    <span>{project.status}</span>
  </div>
  <p class="summary">{project.summary}</p>
  <p class="technologies">{project.technologies.join(" · ")}</p>
  <div class="software-footer">
    <p>{project.role}</p>
    <div class="software-links">
      {detailUrl && <a class="text-link" href={detailUrl}>{lang === "es" ? "detalle →" : "details →"}</a>}
      {project.demo && <a class="text-link" href={project.demo} target="_blank" rel="noopener noreferrer">{demoLabel}</a>}
      {project.repository && <a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">github ↗</a>}
    </div>
  </div>
</article>

<style>
  .software-card {
    min-width: 0;
  }

  .software-image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--soft);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .software-image:hover img,
  .software-image:focus-visible img {
    transform: scale(1.02);
  }

  .software-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.85rem;
  }

  h3 {
    font-family: var(--meta-font);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .software-heading span,
  .technologies,
  .software-footer {
    color: var(--muted);
    font-family: var(--meta-font);
    font-size: 0.78rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .software-heading span {
    flex: none;
  }

  .summary {
    max-width: 42rem;
    margin-top: 0.45rem;
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .technologies {
    margin-top: 0.65rem;
  }

  .software-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    border-top: 1px solid #d7d7d4;
    padding-top: 0.65rem;
  }

  .software-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-left: auto;
  }

  .compact .summary {
    font-size: 0.82rem;
  }

  .compact h3 {
    font-size: 0.92rem;
  }

  @media (max-width: 480px) {
    .software-image {
      aspect-ratio: 16 / 10;
    }

    .software-heading {
      align-items: flex-start;
      gap: 0.5rem;
    }

    .software-heading span {
      max-width: 45%;
      line-height: 1.25;
      text-align: right;
    }

    .software-links a {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    img {
      transition: none;
    }
  }
</style>
