---
import type { Lang } from "../i18n";
interface Props { lang: Lang; esHref: string; enHref: string }
const { lang, esHref, enHref } = Astro.props as Props;
---
<div class="language-selector flex items-center gap-1.5 border-l border-[var(--line)] pl-3 text-[0.7rem] leading-none sm:gap-2 sm:pl-5 sm:text-xs">
  <a href={esHref}
     class="text-link"
     aria-current={lang === 'es' ? 'true' : undefined}>es</a>
  <span class="muted">/</span>
  <a href={enHref}
     class="text-link"
     aria-current={lang === 'en' ? 'true' : undefined}>en</a>
</div>
