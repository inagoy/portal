---
import { getStrings, normalizeLang, type Lang } from "../i18n";
interface Props { lang?: Lang }
const pageLang = normalizeLang(Astro.props.lang as string | undefined);
const t = getStrings(pageLang);
---
<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="form"
  class="needs-validation"
  data-astro-reload
  data-sending={t.form.sending}
  data-success={t.form.success}
  data-error={t.form.error}
  novalidate>
  
   <!-- Add your Web3Forms Access Key -->
  <input type="hidden" name="access_key" value="be4c95cc-555d-48ba-a27c-68d9bd34f384" />
  <!-- Set Web3Forms email subject -->
  <input type="hidden" name="subject" value="NEW MESSAGE AT WEB" />
  <div class="contact-form-block">
    <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
    <div class="contact-fields grid grid-cols-1">
      <div class="contact-field-row">
        <label for="name" class="sr-only">{t.form.name_placeholder}</label>
        <input
          id="name"
          type="text"
          placeholder={t.form.name_placeholder}
          required
          name="name"
          class="field"
        />
        <div class="validation-feedback empty-feedback invalid-feedback">
          {t.form.name_required}
        </div>
      </div>
      <div class="contact-field-row">
        <label for="email_address" class="sr-only">{t.form.email_label}</label>
        <input
          id="email_address"
          type="email"
          placeholder={t.form.email_placeholder}
          name="email"
          required
          class="field"
        />
        <div class="validation-feedback empty-feedback">
          {t.form.email_required}
        </div>
        <div class="validation-feedback invalid-feedback">
          {t.form.email_invalid}
        </div>
      </div>
      <div class="contact-field-row">
        <label for="message" class="sr-only">{t.form.message_placeholder}</label>
        <textarea
          id="message"
          name="message"
          required
          placeholder={t.form.message_placeholder}
          class="field h-36 resize-none"
        ></textarea>
        <div class="validation-feedback empty-feedback invalid-feedback">
          {t.form.message_required}
        </div>
      </div>
    </div>
    <div class="contact-submit">
      <button class="button" type="submit">
        {t.form.send_button}
      </button>
      <div id="result" class="form-result text-sm" role="status" aria-live="polite" aria-atomic="true"></div>
    </div>
  </div>
</form>

<style>
  .contact-form-block {
    border: 2px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
    box-shadow: 0 8px 22px rgb(23 23 17 / 0.17);
  }

  .contact-fields {
    counter-reset: contact-field;
  }

  .contact-submit {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    justify-items: center;
    gap: 0.75rem;
    border-top: 1.5px solid var(--line);
    background: rgb(243 239 220 / 0.75);
    padding: 1rem;
  }

  .contact-submit .button {
    grid-column: 2;
    width: 100%;
    margin: 0;
    box-shadow: none;
    transform: none;
  }

  .contact-submit .button:hover,
  .contact-submit .button:focus-visible,
  .contact-submit .button:active {
    box-shadow: none;
    transform: none;
  }

  .contact-submit .form-result {
    grid-column: 1 / -1;
  }

  .contact-field-row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: start;
    border-bottom: 1.5px solid var(--line);
    background: rgb(243 239 220 / 0.75);
    counter-increment: contact-field;
  }

  .contact-field-row::before {
    content: "A" counter(contact-field);
    padding: 0.75rem 0 0 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .contact-field-row:nth-child(odd) {
    background: rgb(78 143 82 / 0.82);
  }

  .contact-field-row:last-child {
    border-bottom: 0;
  }

  .contact-field-row .field {
    grid-column: 2;
    border: 0;
    background: transparent;
    font-weight: 700;
  }

  .contact-field-row .field:focus {
    background: rgb(255 255 255 / 0.18);
  }

  .contact-field-row .field:focus-visible {
    outline-offset: -2px;
  }

  .contact-field-row .invalid-feedback,
  .contact-field-row .empty-feedback {
    grid-column: 2;
  }

  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .validation-feedback {
    padding: 0 0.9rem 0.75rem;
    color: #97152e;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .was-validated .contact-field-row .field:invalid {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .was-validated .contact-field-row:has(:invalid) {
    box-shadow: inset 0 0 0 2px #97152e;
  }

  .form-result:empty {
    display: none;
  }

  .form-result {
    width: 100%;
    border: 2px solid var(--line);
    border-radius: 3px;
    padding: 0.65rem 0.75rem;
    color: var(--text-strong);
    font-weight: 800;
    text-transform: uppercase;
  }

  .form-result-sending {
    background: var(--paper);
  }

  .form-result-success {
    background: rgb(78 143 82 / 0.82);
    box-shadow: 2px 2px 0 var(--line);
  }

  .form-result-error {
    background: color-mix(in srgb, var(--accent) 55%, var(--paper));
  }

  @media (min-width: 640px) {
    .contact-field-row::before {
      padding-top: 0.85rem;
    }
  }

  @media (max-width: 639px) {
    .contact-form-block,
    .form-result,
    .contact-submit,
    .contact-field-row {
      border-width: 1px;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("form");
    const result = document.getElementById("result");
    const submitButton = form.querySelector('button[type="submit"]');
    const showResult = (state, message) => {
      result.className = `form-result form-result-${state} text-sm`;
      result.textContent = message;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      form.classList.add("was-validated");

      if (!form.checkValidity()) {
        form.querySelector(":invalid").focus();
        return;
      }

      showResult("sending", form.dataset.sending || "Sending...");
      let sent = false;

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message);
        }

        showResult("success", form.dataset.success || "Message sent successfully!");
        submitButton.hidden = true;
        sent = true;
        form.reset();
        form.classList.remove("was-validated");
      } catch (error) {
        console.error(error);
        showResult("error", form.dataset.error || "Something went wrong!");
      }

      setTimeout(() => {
        result.textContent = "";
        submitButton.hidden = false;
      }, sent ? 8000 : 5000);
    });
  }, { once: true });
</script>
