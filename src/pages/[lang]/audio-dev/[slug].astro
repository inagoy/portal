---
import Layout from "../../../layouts/Layout.astro";
import ProjectMediaPlayer from "../../../components/ProjectMediaPlayer.astro";
import {
  getAudioSoftwareProjects,
  getOtherSoftwareProjects,
  getSoftwareProjectSlug,
} from "../../../config";
import type { Lang } from "../../../i18n";
import type { SEOInfo, SoftwareProject } from "../../../types/config";

export function getStaticPaths() {
  return (["es", "en"] as const).flatMap((lang) =>
    [...getAudioSoftwareProjects(lang), ...getOtherSoftwareProjects(lang)].map((project) => ({
      params: { lang, slug: getSoftwareProjectSlug(project) },
      props: { lang, project },
    })),
  );
}

interface Props {
  lang: Lang;
  project: SoftwareProject;
}

const { lang, project } = Astro.props;
const labels = lang === "es"
  ? { back: "audio dev", role: "rol", technologies: "tecnologías", status: "estado", demo: "ver", repository: "código" }
  : { back: "audio dev", role: "role", technologies: "technologies", status: "status", demo: "open", repository: "code" };
const demoDestination = project.demo?.includes("youtu") ? "youtube" : lang === "es" ? "sitio" : "website";
const seo: SEOInfo = {
  title: `${project.name} | Iñaki Goyeneche`,
  description: project.summary,
  image: project.image,
};
---

<Layout seo={seo} lang={lang} context="audio-dev">
  <article class="page project-detail">
    <a class="text-link back-link" href={`/${lang}/audio-dev`}>← {labels.back}</a>
    <div class="detail-grid">
      <figure class="detail-artwork">
        <img src={project.image} alt={`${project.name} interface`} loading="eager" fetchpriority="high" decoding="async" />
      </figure>
      <div class="detail-copy">
        <h1>{project.name}</h1>
        <p class="summary">{project.summary}</p>
        <dl class="detail-meta">
          <div><dt>{labels.role}</dt><dd>{project.role}</dd></div>
          <div><dt>{labels.technologies}</dt><dd>{project.technologies.join(" · ")}</dd></div>
          <div><dt>{labels.status}</dt><dd>{project.status}</dd></div>
        </dl>
        <div class="external-links">
          {project.demo && <a class="text-link" href={project.demo} target="_blank" rel="noopener noreferrer">{labels.demo} {demoDestination} ↗</a>}
          {project.repository && <a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">{labels.repository} github ↗</a>}
        </div>
      </div>
    </div>
    {project.demo && <ProjectMediaPlayer url={project.demo} title={project.name} lang={lang} />}
  </article>
</Layout>

<style>
  .project-detail {
    padding-top: clamp(1.5rem, 3vw, 3rem);
  }

  .back-link,
  .detail-meta,
  .external-links {
    font-family: var(--meta-font);
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .back-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: 0.82rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    gap: clamp(2rem, 5vw, 5rem);
    margin-top: 1rem;
    border-top: 1px solid var(--line);
    padding-top: clamp(1.5rem, 3vw, 3rem);
  }

  .detail-artwork {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--soft);
  }

  .detail-artwork img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail-copy {
    align-self: end;
    min-width: 0;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .summary {
    max-width: 38rem;
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.45;
  }

  .detail-meta {
    margin-top: clamp(2rem, 4vw, 4rem);
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
  }

  .detail-meta > div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-block: 0.75rem;
  }

  dt {
    color: var(--muted);
  }

  dd {
    min-width: 0;
    margin: 0;
  }

  .external-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.84rem;
  }

  .external-links a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
  }

  @media (max-width: 760px) {
    .project-detail {
      padding-top: 0.75rem;
    }

    .detail-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-top: 0.5rem;
      padding-top: 1rem;
    }

    h1 {
      font-size: clamp(2.25rem, 12vw, 4rem);
    }

    .detail-meta {
      margin-top: 1.5rem;
    }

    .detail-meta > div {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }
</style>
