---
export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

import Layout from "../../layouts/Layout.astro";
import { getProgrammingProjectsPageContent, getContactPageContent } from "../../config";
import { normalizeLang, getStrings } from "../../i18n";
import ProjectCard from "../../components/MusicProjectCard.astro";
import SocialLink from "../../components/SocialLink.astro";

const lang = normalizeLang(Astro.params.lang as string);
const t = getStrings(lang);
const programmingProjectsPageContent = getProgrammingProjectsPageContent(lang);
const contactContent = getContactPageContent(lang);
const githubLink = contactContent.links.find((link) => link.title === "github");
---

<Layout seo={programmingProjectsPageContent.seo} lang={lang}>
  <section class="page pt-8 sm:pt-10">
    <div class="page-header portfolio-header">
      <h1 class="page-title">{t.headings.programming_portfolio}</h1>
      <p class="muted mt-3 text-sm sm:mt-4 sm:text-base">{programmingProjectsPageContent.subtitle}</p>
    </div>
    <div class="audio-dev-projects grid grid-cols-1">
      {
        programmingProjectsPageContent.projects.map((project) => (
          <ProjectCard {...project} lang={lang} />
        ))
      }
    </div>
  </section>
  <section class="page mt-10 sm:mt-12">
    <div class="flex flex-wrap items-center gap-3 sm:gap-4">
      <h2 class="muted">{t.headings.more_projects_on}</h2>
      {
        githubLink && (
          <SocialLink
            title={githubLink.title}
            url={githubLink.url}
            icon={githubLink.icon}
            external={githubLink.external}
          />
        )
      }
    </div>
  </section>
</Layout>

<style>
  .page-header.portfolio-header {
    margin-bottom: 0.75rem;
  }

  :global(.audio-dev-projects > .music-card:first-child) {
    border-top: 0;
  }

  @media (min-width: 640px) {
    .page-header.portfolio-header {
      margin-bottom: 1rem;
    }
  }
</style>
