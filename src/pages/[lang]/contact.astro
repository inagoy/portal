---
export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

import Layout from "../../layouts/Layout.astro";
import { getContactPageContent } from "../../config";
import { normalizeLang, getStrings } from "../../i18n";
import SocialLink from "../../components/SocialLink.astro";
import MailForm from "../../components/MailForm.astro";

const lang = normalizeLang(Astro.params.lang as string);
const t = getStrings(lang);
const contactPageContent = getContactPageContent(lang);
---

<Layout seo={contactPageContent.seo} lang={lang}>
  <section class="page pt-8 sm:pt-10">
    <div class="page-header">
      <h1 class="page-title">{t.headings.contact}</h1>
      <p class="muted mt-3 text-sm sm:mt-4 sm:text-base">{contactPageContent.subtitle}</p>
    </div>
  </section>
  <section class="page">
    <MailForm lang={lang}/>
  </section>
  <section class="page contact-socials">
    <p class="contact-socials-heading muted">{t.headings.my_networks}</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-2.5 sm:gap-x-5 sm:gap-y-3">
      {
        contactPageContent.links.map((link: any) => (
          <li>
            <SocialLink title={link.title} url={link.url} icon={link.icon} external={link.external} />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .page.contact-socials {
    padding-top: 2rem;
  }

  .contact-socials-heading {
    margin-bottom: 1.25rem;
    border-top: 2px solid var(--line);
    padding-top: 1.5rem;
    font-weight: 700;
  }

  @media (min-width: 640px) {
    .page.contact-socials {
      padding-top: 2.5rem;
    }
  }
</style>
