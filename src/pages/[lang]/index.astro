---
export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

import Layout from "../../layouts/Layout.astro";
import { getHomePageContent, identity } from "../../config";
import { normalizeLang } from "../../i18n";
import SocialLink from "../../components/SocialLink.astro";
import Link from "../../components/Link.astro";

const lang = normalizeLang(Astro.params.lang as string);
const homePageContent = getHomePageContent(lang);
const [firstName, lastName] = identity.name.split(" ");
---
<Layout seo={homePageContent.seo} lang={lang}>
  <section class="page pt-8 sm:pt-10">
    <div class="page-header">
      <h1 class="home-heading" aria-label={`${identity.name} — ${homePageContent.role}`}>
        <span class="home-heading-row">
          <span class="page-title home-title">{firstName}</span>
          <span class="home-role muted">{homePageContent.role}</span>
        </span>
        <span class="page-title home-title home-last-name">
          {lastName}<span class="ml-[0.45em] inline-block align-middle text-[0.36em] font-semibold lowercase tracking-normal">(inagoi)</span>
        </span>
      </h1>
    </div>

    <ul class="flex flex-wrap gap-x-4 gap-y-2.5 sm:gap-x-5 sm:gap-y-3">
      {
        homePageContent.socialLinks.map((link: any) => (
          <li>
            <SocialLink
              title={link.title}
              url={link.url}
              icon={link.icon}
              external={link.external}
              disappearsOnHover={link.disappearsOnHover}
            />
          </li>
        ))
      }
    </ul>

    <div class="home-links mt-8 sm:mt-12">
      {
        homePageContent.links.map((link: any) => (
          <Link text={link.title} href={`/${lang}${link.url}`} external={link.external}/>
        ))
      }
    </div>
  </section>
</Layout>
