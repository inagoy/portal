---
export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
  ];
}

import MusicPortfolioPage from "../../components/MusicPortfolioPage.astro";
import { normalizeLang } from "../../i18n";

const lang = normalizeLang(Astro.params.lang as string);
---

