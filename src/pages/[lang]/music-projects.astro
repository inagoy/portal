---
export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

import Layout from "../../layouts/Layout.astro";
import { getMusicProjectsPageContent } from "../../config";
import { normalizeLang, getStrings } from "../../i18n";
import ProjectCard from "../../components/MusicProjectCard.astro";
import type { MusicProject } from "../../types/config";

const lang = normalizeLang(Astro.params.lang as string);
const t = getStrings(lang);
const musicProjectsPageContent = getMusicProjectsPageContent(lang);
const kamehouseLabel = lang === "es" ? "en estudio kamehouse" : "at estudio kamehouse";
type ProjectGroup = {
  source: MusicProject["source"] | "personal";
  projects: MusicProject[];
};
const projectGroups = musicProjectsPageContent.projects.reduce<ProjectGroup[]>((groups, project) => {
  const source = project.source ?? "personal";
  const lastGroup = groups[groups.length - 1];

  if (lastGroup?.source === source) {
    lastGroup.projects.push(project);
    return groups;
  }

  groups.push({ source, projects: [project] });
  return groups;
}, []);
---

<Layout seo={musicProjectsPageContent.seo} lang={lang}>
  <section class="page pt-8 sm:pt-10">
    <div class="page-header">
      <h1 class="page-title">{t.headings.music_portfolio}</h1>
      <p class="muted mt-3 text-sm sm:mt-4 sm:text-base">{musicProjectsPageContent.subtitle}</p>
    </div>
    <div class="grid grid-cols-1">
      {
        projectGroups.map((group) => (
          group.source === "kamehouse" ? (
            <div class="kamehouse-group">
              <p class="kamehouse-label">{kamehouseLabel}</p>
              <div class="kamehouse-list">
                {group.projects.map((project) => (
                  <ProjectCard {...project} lang={lang} compact />
                ))}
              </div>
            </div>
          ) : (
            group.projects.map((project) => (
              <ProjectCard {...project} lang={lang} />
            ))
          )
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .kamehouse-group {
    position: relative;
    margin: 0.15rem 0 0.55rem;
    padding-left: 2.2rem;
  }

  :global(.kamehouse-list > .music-card-compact) {
    position: relative;
  }

  :global(.kamehouse-list > .music-card-compact)::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: var(--kamehouse-line-inset);
    width: 2px;
    background: #f2c94c;
    pointer-events: none;
    transition: opacity 120ms ease 320ms;
  }

  .kamehouse-label {
    position: absolute;
    top: 0.8rem;
    left: 0;
    color: #f2c94c;
    font-size: 0.64rem;
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
    transform: rotate(180deg);
    writing-mode: vertical-rl;
    transition: opacity 120ms ease 320ms;
  }

  .kamehouse-list {
    --kamehouse-line-inset: -1.1rem;
    --kamehouse-player-pull: 2.2rem;
    margin-left: auto;
    width: min(100%, 36rem);
  }

  :global(.kamehouse-list > details[open].music-card-compact)::before,
  :global(.kamehouse-group:has(details[open]) .kamehouse-label) {
    opacity: 0;
    transition-delay: 0ms;
  }

  @media (min-width: 640px) {
    .kamehouse-group {
      padding-left: 2.8rem;
    }

    .kamehouse-list {
      --kamehouse-line-inset: -3.4rem;
      --kamehouse-player-pull: 4.8rem;
      width: calc(100% - 2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.kamehouse-list > .music-card-compact)::before,
    .kamehouse-label {
      transition: none;
    }
  }
</style>
